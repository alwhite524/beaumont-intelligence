  "items": [
    {
      "item": "D.1",
      "section": "Consent",
      "title": "Approval of November 17 minutes",
      "summary": "Consider approval of the November 17, 2026 Council minutes."
    },
    {
      "item": "D.2",
      "section": "Consent",
      "title": "Fourth of July fireworks services",
      "summary": "Consider a Garden State Fireworks agreement capped at $310,000 for 2027–2029. The two optional one-year extensions are priced at $115,000 each, for a potential five-year value of $540,000.",
      "checks": [
        {
          "title": "Confirm the effective date and initial expiration",
          "text": "The staff report describes July 1, 2027 through June 30, 2030. The draft leaves the effective date blank on a 2026 signature line and provides for automatic termination after July 31, 2029, subject to the renewal provisions.",
          "packetPages": [
            14,
            30
          ]
        }
      ]
    },
    {
      "item": "D.3",
      "section": "Consent",
      "title": "Citywide facility painting closeout",
      "summary": "Consider recording Kodiak Painting’s Notice of Completion for CIP ISFB-17. Staff reports a final contract cost of $75,906.73 and $3,795.34 in retention to be released 35 days after filing."
    },
    {
      "item": "D.4",
      "section": "Consent",
      "title": "AB Landscape weed abatement amendment",
      "summary": "Consider increasing the contract ceiling from $160,000 to $360,000, subject to annual funding authorization, and extending the term through December 31, 2028. The City seeks applicable reimbursement from property owners and can add unpaid charges to tax bills."
    },
    {
      "item": "D.5",
      "section": "Consent",
      "title": "Appointments to boards, committees and commissions",
      "summary": "Consider the proposed selection process for Council assignments and City committee appointments. The report anticipates mayoral recommendations for outside assignments on December 15 and committee appointments on January 19."
    },
    {
      "item": "F.1",
      "section": "Public Hearing",
      "title": "City Treasurer duties ordinance",
      "summary": "Hold a public hearing and consider introducing an amendment to Beaumont Municipal Code § 2.08.120. It removes the current list of locally prescribed operational duties, assigns administrative and technical support to the City Manager or designee, and provides for continuity during an absence or vacancy. Staff proposes a later second reading and anticipates no direct additional appropriation."
    },
    {
      "item": "G.1",
      "section": "Action",
      "title": "Third fire station and temporary coverage",
      "summary": "Staff asks Council to direct a search south of I-10 and east of Highway 79, then return with property options, preliminary acquisition costs and potential funding sources. The report evaluates six locations and estimates $13–15 million for construction and $3.5 million annually for staffing and operations. Temporary coverage during Pennsylvania Avenue grade separation is a separate question; options include adapting a building or leasing modular space."
    },
    {
      "item": "G.2",
      "section": "Action",
      "title": "Three-year Cherry Festival agreement",
      "summary": "Consider a three-year MOU with Cherries of the Pass Foundation. The City would lead festival operations and retain final approval of event plans. For 2027, staff requests $550,000 in General Fund appropriations and $255,000 in projected revenue, for an estimated $295,000 net General Fund impact. Ticket projections assume 15,000 paid admissions at an average of $10.",
      "checks": [
        {
          "title": "Complete the stage production exhibit before signing",
          "text": "The staff report points to Exhibit B for City-funded stage, sound and lighting specifications. Exhibit B still contains a drafting note calling for the baseline dimensions, equipment and staffing to be inserted before execution. Those specifications define which production services the City would fund.",
          "packetPages": [
            150,
            167
          ]
        }
      ]
    },
    {
      "item": "G.3",
      "section": "Action",
      "title": "2027 Council meeting dates",
      "summary": "Consider the 2027 schedule. Staff flags January 5, July 6, August 3 and December 21 for cancellation."
    }
  ],
